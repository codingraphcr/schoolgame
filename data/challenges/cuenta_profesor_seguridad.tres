[gd_resource type="Resource" script_class="ChoiceChallenge" format=3]

[ext_resource type="Script" path="res://systems/challenges/choice_question.gd" id="1_eyx36"]
[ext_resource type="Script" path="res://systems/challenges/choice_option.gd" id="2_wgvbl"]
[ext_resource type="Script" path="res://systems/challenges/choice_challenge.gd" id="3_1g710"]

[sub_resource type="Resource" id="Resource_nj5li"]
script = ExtResource("2_wgvbl")
text = "Un código por mensaje de texto (SMS)"
detail = "Llega al celular cada vez que inicia sesión"
feedback = "Funciona y es mejor que nada, pero los SMS se pueden interceptar o robar duplicando la tarjeta SIM del teléfono. Hay una opción más segura."

[sub_resource type="Resource" id="Resource_pactf"]
script = ExtResource("2_wgvbl")
text = "Una aplicación de autenticación"
detail = "Genera en el celular un código nuevo cada 30 segundos"
correct = true
feedback = "¡Sí! El código se crea dentro del teléfono y cambia cada 30 segundos: aunque alguien robe la contraseña, sin el teléfono no puede entrar. Es «algo que tienes», además de «algo que sabes»."

[sub_resource type="Resource" id="Resource_djbst"]
script = ExtResource("2_wgvbl")
text = "Una pregunta de seguridad"
detail = "«¿Cómo se llamaba tu primera mascota?»"
feedback = "No. Es otra cosa que «se sabe», igual que la contraseña, y la respuesta suele estar en redes sociales. No es un segundo factor de verdad."

[sub_resource type="Resource" id="Resource_i5ha7"]
script = ExtResource("1_eyx36")
prompt = "Ahora la verificación en dos pasos. ¿Cuál es el método más seguro para el segundo paso?"
options = Array[ExtResource("2_wgvbl")]([SubResource("Resource_nj5li"), SubResource("Resource_pactf"), SubResource("Resource_djbst")])

[resource]
script = ExtResource("3_1g710")
id = &"cuenta_profesor_seguridad"
title = "Asegurar la cuenta del profesor"
ecos_reward = 0
questions = Array[ExtResource("1_eyx36")]([SubResource("Resource_i5ha7")])
