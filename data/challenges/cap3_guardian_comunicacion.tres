[gd_resource type="Resource" script_class="ChoiceChallenge" format=3]

[ext_resource type="Script" path="res://systems/challenges/choice_question.gd" id="1_question"]
[ext_resource type="Script" path="res://systems/challenges/choice_option.gd" id="2_option"]
[ext_resource type="Script" path="res://systems/challenges/choice_challenge.gd" id="3_challenge"]

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("2_option")
text = "La condición de finalización"
correct = true
feedback = "Correcto: sin una condición de salida que se cumpla, el ciclo no termina nunca (como la cinta del taller, y como Bucle)."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("2_option")
text = "El color de la interfaz"
feedback = "Pista: el color no cambia lo que hace el programa. ¿Qué decide cuándo termina un ciclo?"

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("2_option")
text = "El nombre del archivo"
feedback = "Pista: el nombre no detiene nada. Acuérdate de la cinta automática del taller."

[sub_resource type="Resource" id="Question_0"]
script = ExtResource("1_question")
prompt = "Un programa repite una tarea sin detenerse. ¿Qué elemento debe revisarse primero?"
options = Array[ExtResource("2_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])

[resource]
script = ExtResource("3_challenge")
id = &"cap3_guardian_comunicacion"
title = "Guardián de comunicación"
ecos_reward = -1
questions = Array[ExtResource("1_question")]([SubResource("Question_0")])
