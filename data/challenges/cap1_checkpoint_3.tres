[gd_resource type="Resource" script_class="ChoiceChallenge" format=3]

[ext_resource type="Script" path="res://systems/challenges/choice_question.gd" id="1_question"]
[ext_resource type="Script" path="res://systems/challenges/choice_option.gd" id="2_option"]
[ext_resource type="Script" path="res://systems/challenges/choice_challenge.gd" id="3_challenge"]

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("2_option")
text = "Utilizar controles de acceso adecuados"
detail = "Cada quien entra solo a lo que le corresponde"
correct = true
feedback = "¡Correcto! La confidencialidad significa que solo las personas autorizadas acceden a la información. Los controles de acceso lo hacen posible."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("2_option")
text = "Compartir la contraseña con el grupo"
detail = "Para que todos puedan ayudar"
feedback = "Compartir contraseñas hace imposible saber quién entró y permite que cualquiera vea todo. Cada persona necesita su propio acceso."

[sub_resource type="Resource" id="Option_3"]
script = ExtResource("2_option")
text = "Dejar los archivos en una carpeta pública"
detail = "Así nadie pierde tiempo pidiendo permiso"
feedback = "Una carpeta pública es lo contrario de confidencial: cualquiera puede verla."

[sub_resource type="Resource" id="Question_0"]
script = ExtResource("1_question")
prompt = "¿Qué ayuda a proteger la confidencialidad?"
options = Array[ExtResource("2_option")]([SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])

[resource]
script = ExtResource("3_challenge")
id = &"cap1_checkpoint_3"
title = "Checkpoint 3 · Confidencialidad"
ecos_reward = 0
questions = Array[ExtResource("1_question")]([SubResource("Question_0")])
