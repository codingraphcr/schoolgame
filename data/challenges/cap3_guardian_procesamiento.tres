[gd_resource type="Resource" script_class="ChoiceChallenge" format=3]

[ext_resource type="Script" path="res://systems/challenges/choice_question.gd" id="1_question"]
[ext_resource type="Script" path="res://systems/challenges/choice_option.gd" id="2_option"]
[ext_resource type="Script" path="res://systems/challenges/choice_challenge.gd" id="3_challenge"]

[sub_resource type="Resource" id="Option_0"]
script = ExtResource("2_option")
text = "Conectarlos a más equipos"
feedback = "Pista: así el problema llega a más equipos. Piensa en lo que hizo el profesor con la carpeta compartida."

[sub_resource type="Resource" id="Option_1"]
script = ExtResource("2_option")
text = "Aislar los equipos afectados"
correct = true
feedback = "Correcto: aislar evita que el problema se propague mientras se investiga."

[sub_resource type="Resource" id="Option_2"]
script = ExtResource("2_option")
text = "Compartir el archivo"
feedback = "Pista: compartir lo sospechoso lo multiplica. Lo primero es que no salga de donde está."

[sub_resource type="Resource" id="Question_0"]
script = ExtResource("1_question")
prompt = "Dos equipos reciben un archivo sospechoso. ¿Cuál es la primera medida para impedir que el problema se propague?"
options = Array[ExtResource("2_option")]([SubResource("Option_0"), SubResource("Option_1"), SubResource("Option_2")])

[resource]
script = ExtResource("3_challenge")
id = &"cap3_guardian_procesamiento"
title = "Guardián de procesamiento"
ecos_reward = -1
questions = Array[ExtResource("1_question")]([SubResource("Question_0")])
