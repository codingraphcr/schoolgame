[ext_resource type="Script" path="res://systems/grimorio/grimorio_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
category = 2
order = 2
title = "Ventana emergente"
subtitle = "Amenaza · Anuncio"
text = "Anuncios que aparecen de golpe con premios, urgencias y direcciones raras. Puedes pararte sobre su barra, pero algunas se cierran solas al pisarlas."
