[ext_resource type="Script" path="res://systems/grimorio/grimorio_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
category = 3
order = 2
title = "Contraseña segura"
subtitle = "Concepto · Cuentas"
text = "Una contraseña segura es larga, única para cada cuenta y difícil de adivinar. «123456» se descubre en segundos; una frase larga puede tardar siglos."
facts = Dictionary[String, String]({"Largo": "12 caracteres o más", "Consejo": "Una frase, y no repetirla"})
