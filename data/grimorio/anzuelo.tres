[gd_resource type="Resource" script_class="GrimorioEntry" format=3]

[ext_resource type="Script" path="res://systems/grimorio/grimorio_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
category = 2
order = 0
title = "Anzuelo de phishing"
subtitle = "Amenaza · Engaño"
text = "Un sobre que parece inofensivo y llama la atención. Es un cebo: si lo abres, alguien obtiene justo lo que buscaba. Así funcionan los correos de phishing."
facts = Dictionary[String, String]({"Peligro": "Alto", "Dónde": "Laboratorio", "Defensa": "Desconfía de lo urgente"})
unlock_quest = &"prologo"
unlock_step = &"revisar_computadora"
