title = "ls"
subtitle = "Comando de terminal · Linux"
text = "Lista lo que hay dentro de una carpeta. Las carpetas aparecen con / al final. Es lo primero que conviene escribir al llegar a un sistema."
facts = Dictionary[String, String]({"Sintaxis": "ls [carpeta]", "Ejemplo": "ls cuenta", "Resultado": "configuracion.txt", "Relacionado": "Carpetas y archivos"})
