title = "Aegis Pulse"
subtitle = "Habilidad · Aegis"
text = "Aegis dispara un pulso de energía al objetivo válido más cercano que pueda alcanzar (enemigos o interruptores fuera del alcance de Kai). Solo dispara cuando Kai se lo pide, y necesita un momento entre disparos."
