[resource]
script = ExtResource("1_entry")
category = 5
order = 4
title = "ECOS"
subtitle = "Recurso · Datos recuperados"
text = "Pequeños residuos de información digital que quedan cuando una criatura digital es neutralizada o una estructura de datos se fragmenta. Con la Visión Digital se ven como fragmentos luminosos de energía azul y violeta. Los comerciantes vinculados con la tecnología los usan como moneda.

«Incluso los datos corruptos pueden conservar algo de valor»."
facts = Dictionary[String, String]({"Obtención": "Al derrotar enemigos y recuperar sus datos residuales", "Utilidad": "Pueden intercambiarse por mejoras, objetos y otros recursos durante la aventura"})
image = ExtResource("2_art")
unlock_flag = &"ecos_descubiertos"
