[ext_resource type="Script" path="res://systems/grimorio/grimorio_entry.gd" id="1_entry"]

[resource]
script = ExtResource("1_entry")
category = 1
order = 12
title = "cd"
subtitle = "Comando de terminal · Linux"
text = "Entra a una carpeta (change directory). cd .. vuelve a la carpeta de arriba y cd ~ a tu carpeta personal. Pista: con Tab se completa el nombre."
facts = Dictionary[String, String]({"Sintaxis": "cd carpeta", "Ejemplo": "cd cuenta", "Resultado": "El prompt cambia a ~/cuenta", "Relacionado": "Rutas relativas"})
unlock_command = &"cd"
