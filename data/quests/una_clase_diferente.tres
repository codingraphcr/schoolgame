[gd_resource type="Resource" script_class="Quest" format=3]

[ext_resource type="Script" path="res://systems/quests/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://systems/quests/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_step")
id = &"ir_a_clase"
objective = "Ve a tu clase: la Sala 3, en el pasillo principal."

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_step")
id = &"ver_fallas"
objective = "¿Quién está alterando las computadoras de práctica?"

[sub_resource type="Resource" id="Resource_2"]
script = ExtResource("2_step")
id = &"revisar_registro"
objective = "Revisa el registro de eventos en la computadora de tu puesto."

[sub_resource type="Resource" id="Resource_3"]
script = ExtResource("2_step")
id = &"seguir_criaturas"
objective = "Sigue a las criaturas por el pasillo y las escaleras."

[sub_resource type="Resource" id="Resource_4"]
script = ExtResource("2_step")
id = &"biblioteca"
objective = "Arregla lo que hicieron en la computadora de la biblioteca."

[sub_resource type="Resource" id="Resource_5"]
script = ExtResource("2_step")
id = &"pedir_permiso"
objective = "Pídele permiso al profesor (en la Sala 3) para entrar al cuarto técnico."

[resource]
script = ExtResource("1_quest")
id = &"una_clase_diferente"
title = "Una clase diferente"
steps = Array[ExtResource("2_step")]([SubResource("Resource_0"), SubResource("Resource_2"), SubResource("Resource_1"), SubResource("Resource_3"), SubResource("Resource_4"), SubResource("Resource_5")])
completion_title = "NIVEL 1 COMPLETADO"
completion_subtitle = "UNA CLASE DIFERENTE"
completion_flag = &"nivel_1_completado"
next_quest = &"travesuras_en_el_sistema"
