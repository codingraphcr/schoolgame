[gd_resource type="Resource" script_class="Quest" format=3]

[ext_resource type="Script" path="res://systems/quests/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://systems/quests/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Step_0"]
script = ExtResource("2_step")
id = &"explorar_estacion"
objective = "Explora la Estación Lázaro."
room_id = &"lazaro_vestibulo"

[sub_resource type="Resource" id="Step_1"]
script = ExtResource("2_step")
id = &"encontrar_aegis"
objective = "Sigue la señal azul hasta el fondo de la estación."
room_id = &"lazaro_nucleo"

[sub_resource type="Resource" id="Step_2"]
script = ExtResource("2_step")
id = &"reparar_aegis"
objective = "Repara a la unidad dañada («Eco en la Red»)."
room_id = &"lazaro_nucleo"

[sub_resource type="Resource" id="Step_3"]
script = ExtResource("2_step")
id = &"decision"
objective = "Habla con Aegis."
room_id = &"lazaro_nucleo"

[sub_resource type="Resource" id="Step_4"]
script = ExtResource("2_step")
id = &"escapar"
objective = "¡La estación se cierra! Escapa con Aegis."
room_id = &"lazaro_vestibulo"

[sub_resource type="Resource" id="Step_5"]
script = ExtResource("2_step")
id = &"volver_colegio"
objective = "Vuelve al colegio por la troncal del rack (el claro del bosque)."
room_id = &"fibra_claro"

[sub_resource type="Resource" id="Step_6"]
script = ExtResource("2_step")
id = &"hablar_profesor"
objective = "Cuéntale al profesor qué encontraste."
room_id = &"cuarto_tecnico"

[resource]
script = ExtResource("1_quest")
id = &"la_senal_perdida"
title = "La señal perdida"
category = 0
chapter = 3
steps = Array[ExtResource("2_step")]([SubResource("Step_0"), SubResource("Step_1"), SubResource("Step_2"), SubResource("Step_3"), SubResource("Step_4"), SubResource("Step_5"), SubResource("Step_6")])
completion_title = "FIN DEL CAPÍTULO 3"
completion_subtitle = "AMENAZAS INVISIBLES"
completion_flag = &"capitulo_3_completado"
extra_completion_flags = Array[StringName]([&"nivel_6_completado"])
