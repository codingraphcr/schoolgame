[gd_resource type="Resource" script_class="Quest" format=3]

[ext_resource type="Script" path="res://systems/quests/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://systems/quests/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Resource_0"]
script = ExtResource("2_step")
id = &"ayudar_fibroluz"
objective = "Un Fibroluz no puede transportar su señal: síguelo hasta donde se corta la conexión."
room_id = &"fibra_raices"

[sub_resource type="Resource" id="Resource_1"]
script = ExtResource("2_step")
id = &"reconectar"
objective = "Reconecta los empalmes para que los Fibroluz vuelvan a transportar señales."
room_id = &"fibra_claro"

[resource]
script = ExtResource("1_quest")
id = &"senal_del_barrio"
title = "El bosque que dejó de brillar"
chapter = 3
category = 1
steps = Array[ExtResource("2_step")]([SubResource("Resource_0"), SubResource("Resource_1")])
