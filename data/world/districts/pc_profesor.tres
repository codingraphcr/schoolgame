[gd_resource type="Resource" script_class="DistrictLayout" format=3]

[ext_resource type="Script" path="res://systems/world/district_layout.gd" id="1_dist"]
[ext_resource type="Script" path="res://systems/world/layout_room.gd" id="2_room"]

[sub_resource type="Resource" id="Resource_escritorio"]
script = ExtResource("2_room")
room_id = &"pc_escritorio"
