[gd_resource type="Resource" script_class="RoomTemplate" format=3]

[ext_resource type="Script" path="res://systems/world/room_template.gd" id="1_tmpl"]
[ext_resource type="Script" path="res://systems/world/door_spec.gd" id="2_door"]

[sub_resource type="Resource" id="Resource_oeste"]
script = ExtResource("2_door")
id = &"oeste"
side = 0
entry_id = &"desde_entrada"

[sub_resource type="Resource" id="Resource_este"]
script = ExtResource("2_door")
id = &"este"
side = 1
entry_id = &"desde_laboratorio"

[resource]
script = ExtResource("1_tmpl")
id = &"pasillo"
display_name = "Pasillo"
scene_path = "res://world/zones/zone0/pasillo.tscn"
room_type = &"corridor"
doors = Array[ExtResource("2_door")]([SubResource("Resource_oeste"), SubResource("Resource_este")])
fixed = true
mission_ids = PackedStringArray("prologo")
