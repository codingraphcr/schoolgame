[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Misión secundaria «El bosque que dejó de brillar» (Capítulo 3): empieza en las Raíces, después de la caída.
(Las Raíces del bosque están casi apagadas. Un Fibroluz da vueltas junto a un cable sin luz, sin nada que llevar.)
Kai: Este bosque está medio apagado... y ese bichito parece preocupado.
(El Fibroluz mira a Kai, mira el cable apagado y vuelve a mirar a Kai.)"
