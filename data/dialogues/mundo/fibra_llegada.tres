[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Primera vez en el Bosque de Fibra (desde la caja de fibra del barrio).
(Kai atraviesa la caja de fibra y aparece en un bosque hecho de luz y de cables.)
Kai: Esto... no es la red del colegio. Es mucho más grande.
Kai: Pero está todo apagado. Los cables casi no brillan.
(Una lucecita con antenas se asoma detrás de una raíz y se vuelve a esconder.)"
