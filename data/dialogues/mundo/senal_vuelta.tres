[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Cuando volvió la señal del barrio («El bosque que dejó de brillar»).
(La luz de la caja del poste está verde.)
Vecino: ¡Kai! ¡Volvió el internet! No sé qué pasó, pero se lo cuento por si acaso.
Kai: Algo me dice que fue cosa de unos amigos muy pequeñitos.
Vecino: ¿Ah?
Kai: Nada, don. ¡Qué dicha!"
