[resource]
script = ExtResource("1_dlg")
script_text = "(La troncal de fibra hacia el este está cortada. Del otro lado se ven luces de una ciudad.)
Kai: Por ahí debe seguir la red... pero no hay enlace. Por ahora no puedo pasar."
