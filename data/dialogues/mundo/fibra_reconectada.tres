[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(La luz corre por el cable. Los árboles de fibra se encienden uno por uno.)
(El Fibroluz recoge un paquete de luz nuevo y sale corriendo por la fibra, hacia el barrio.)
Kai: ¡Eso es! Ahora la señal tiene un camino completo."
