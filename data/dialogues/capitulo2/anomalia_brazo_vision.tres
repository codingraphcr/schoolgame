[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(Otro ↻ gira sobre el brazo. Su hilo de datos va hacia el mismo lado: la puerta del laboratorio.)
Kai [pensativo]: El mismo hilo... ¿De dónde sale?"
