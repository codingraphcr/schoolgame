[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 2, nivel 4: después de corregir la condición de salida (puzle educativo).
Kai: Listo. Ahora tu ciclo tiene una condición de salida.
Bucle: Entonces... cuando la tarea termine, ¿me puedo detener?
Kai [sonriente]: Exacto. Y si algo falla, también: no tenés que repetirlo para siempre.
Bucle: ...Gracias. Creo que voy a descansar un rato."
