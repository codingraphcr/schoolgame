[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 2, nivel 4: el muro se rompe con el Dominio Nulo I. Su origen no se explica (Biblia, XVI).
(El muro se desarma. La salida queda libre.)
Kai [sorprendido]: ...¿Qué fue eso?
Bucle: ¡Todo se movía despacito! ...Menos vos.
Kai [pensativo]: Expansión digital... Dominio Nulo. No sé de dónde salió.
Kai [serio]: Y ese mensaje... «arquitectura reconocida». ¿Reconocida por quién?"
