script = ExtResource("1_dlg")
script_text = "# Capítulo 2, nivel 4 (Código fuera de control): la sala de los procesos repetidos.
Kai [serio]: Procesos... copiándose solos. Alguien dejó un ciclo sin salida.
Kai: La terminal tiene que tener el registro."
