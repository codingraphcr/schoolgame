[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 2, nivel 4: Kai no puede romper el muro (se reconstruye). Despierta el Dominio Nulo I.
Kai [pensativo]: Se reconstruye apenas lo golpeo... es otro bucle.
Kai: Si pudiera hacer que todo vaya más lento... solo un momento...
(La Nullblade vibra. Algo despierta en Kai.)"
