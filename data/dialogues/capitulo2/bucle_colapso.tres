[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 2, nivel 4: después del puzle, el simulador se desestabiliza (los procesos de Bucle).
(El simulador tiembla. Los procesos que Bucle acumuló se derrumban sobre la salida.)
Bucle: ¡Kai! ¡Todo lo que repetí se está amontonando en la salida!
Kai [serio]: Tengo que salir de acá antes de que se caiga todo."
