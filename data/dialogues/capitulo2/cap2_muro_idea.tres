[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 2, nivel 4: Kai no puede romper el muro (se reconstruye). Usa lo que aprendió: atrapar el error.
Kai [pensativo]: Se reconstruye apenas lo golpeo... es otro bucle.
Kai: Golpearlo es repetir lo mismo esperando otro resultado. Así no voy a salir.
Kai [serio]: Pero el muro tiene una terminal. Si el error se repite, puedo atraparlo. ¡Try y catch, como en la clase!"
