[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(El brazo de la mesa baja, toma una pieza, sube... y la vuelve a poner donde estaba. Una y otra vez.)
Kai: Otra máquina que repite lo mismo."
