[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(El robot de prueba lleva la caja hasta la orilla... y la trae de vuelta. Otra vez. Y otra vez.)
Kai [pensativo]: ¿Un error en su programa? Con la Visión Digital tal vez vea qué lo mueve."
