[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 2, nivel 4: después del mensaje «arquitectura reconocida» (la pista del capítulo). No se explica.
Kai [pensativo]: «Arquitectura reconocida»... ¿Reconocida por quién?
Bucle [preocupado]: No fui yo. Yo solo sé repetir cosas.
Kai [serio]: Ya está. La salida está abierta.
Bucle: ¡Gracias, Kai! Por fin... puedo descansar."
