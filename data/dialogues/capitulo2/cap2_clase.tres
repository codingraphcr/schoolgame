[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 2, nivel 3 (El lenguaje de las máquinas): el profesor empieza la unidad de programación.
Prof. Alvarado: Buenos días. Hoy empezamos algo nuevo: programación.
Prof. Alvarado: Una computadora no adivina: hace exactamente lo que le decimos, paso por paso.
Prof. Alvarado: Tres ideas para hoy: las condiciones deciden «si» o «si no»; los ciclos repiten; y las funciones agrupan pasos para usarlos muchas veces.
(En la pizarra, el simulador tarda en cargar. Una barra de progreso empieza, se detiene y vuelve a empezar.)
Prof. Alvarado [preocupado]: Qué raro... el simulador anda lento hoy. Lo voy a revisar.
Prof. Alvarado [sonriente]: Mientras tanto, vayan al taller del laboratorio: hoy es la actividad de robótica. Tres estaciones: un robot clasificador, una cinta automática y un asistente modular.
Kai [pensativo]: Esa barra se repite y se repite... como si algo adentro no supiera parar."
