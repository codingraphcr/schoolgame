[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 2.5: Chip activa su escudo.
Chip: ¡Ja! ¡Escudo de datos! Con esta configuración nadie me toca.
Kai [pensativo]: Una configuración... Si la encuentro, la puedo corregir."
