[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 1.5: la puerta del cuarto técnico está cerrada.
(Chip y Glitch se cuelan por debajo de la puerta. Está cerrada con llave.)
Kai [pensativo]: Podría buscar cómo abrirla...
Kai: No. Ahí están los servidores del colegio. Sin permiso no se entra."
