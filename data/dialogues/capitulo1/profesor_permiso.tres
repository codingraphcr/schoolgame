[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 1.5: Kai le pide permiso al profesor para entrar al cuarto técnico. El profesor tiene que preparar el
# acceso; mientras tanto, Kai busca rastros («Tras las huellas del error»).
Kai: Profe, creo que la falla viene del cuarto técnico. ¿Me deja revisar?
Prof. Alvarado [pensativo]: ¿El cuarto técnico? Ahí no entra cualquiera...
Prof. Alvarado: Está bien, pero dame unos minutos. Tengo que pedir la llave en la Dirección y desconectar el sistema de entrenamiento de la red del colegio.
Prof. Alvarado: Mientras tanto, fijate si la falla dejó rastros por el colegio: por dónde pasó, qué tocó. Antes de arreglar algo, primero se averigua qué pasó.
Kai [pensativo]: Rastros... Con la Visión Digital tal vez los vea."
