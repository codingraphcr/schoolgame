[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 1.1: Kai llega a la Sala 3 y empieza la clase de «Uso ético de la información».
Prof. Alvarado [sonriente]: Justo a tiempo, Kai. Pasá, que ya empezamos.
Prof. Alvarado: Hoy toca «Uso ético de la información».
Prof. Alvarado: Imaginen que les piden revisar una computadora del colegio. ¿Qué pueden mirar?
Prof. Alvarado [pensativo]: Solo lo que el encargado autorizó. Ni un archivo más.
Prof. Alvarado: Para practicar, cada uno va a revisar el registro de eventos del sistema de entrenamiento.
Prof. Alvarado: El registro anota todo: quién entra, cuándo y qué cambia. Kai, el tuyo es el puesto del medio.
(Las computadoras de práctica empiezan a pitar una por una. Las pantallas parpadean.)
Prof. Alvarado [preocupado]: ¿Otra vez? Esta semana el sistema anda rarísimo... Revisen el registro: ahí tiene que salir qué pasa."
