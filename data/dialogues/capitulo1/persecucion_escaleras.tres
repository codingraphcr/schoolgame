[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 1.3: la primera persecución corta llega a las escaleras.
Glitch: ¡Arriba, arriba, arriba!
Chip: ¡No por ahí! ¡Por las escaleras, como dice el plan!
Kai: ¡Esperen!"
