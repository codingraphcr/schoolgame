[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 1.2: después del desafío del registro.
Kai [pensativo]: Un usuario que no existe, cambiando archivos cientos de veces por minuto...
Kai: No es una falla normal. Es alguien jugando con el sistema.
(Por la puerta del laboratorio se asoma una cola naranja.)
Kai: ¡Ahí van!"
