[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 2.6: después de la lectura del Grimorio (la lectura es una pantalla aparte).
Kai [pensativo]: ¿Observador...?
Glitch: ¡Chau, humano raro! ¡Nos vemos!
Chip: No es un adiós. Es una pausa en el plan."
