[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Fin de «Tras las huellas del error»: el profesor ya preparó el acceso al cuarto técnico.
Kai: Profe, encontré rastros de la falla en varios lugares del colegio. No solo en el laboratorio.
Prof. Alvarado [serio]: Entonces se movió por la red del colegio...
Prof. Alvarado: Eso que hiciste tiene nombre: buscar indicadores. Son las señales de que un sistema fue alterado. Se anotan antes de tocar nada.
Prof. Alvarado: Ya tengo la llave. Te acompaño hasta la puerta. Revisás solo el respaldo del sistema de entrenamiento. Nada más.
Kai: Solo el respaldo. Prometido."
