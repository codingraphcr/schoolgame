[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 2.3: Kai llega a la red de entrenamiento.
Kai [sorprendido]: Estoy... adentro. Y esta vez lo hice yo.
Glitch: ¡Chip! ¡Nos siguió!
Chip: Tranquilo. Para eso está la fase tres: ¡corrupción en marcha!
(Detrás de Kai, una barrera de datos corruptos empieza a avanzar.)
Kai [preocupado]: Eso no se ve nada bien."
