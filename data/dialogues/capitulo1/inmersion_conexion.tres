[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 2.2: con la Visión Digital, Kai encuentra la conexión en el monitor.
(Con la Visión Digital, el monitor muestra una conexión que brilla.)
Kai [pensativo]: La otra vez la computadora me jaló.
Kai: Esta vez... voy yo."
