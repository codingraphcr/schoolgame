[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(En la pizarra del pasillo, con la Visión, aparece un dibujo de datos: dos caritas y una flecha hacia las escaleras.)
Kai: Una flecha hacia el cuarto técnico... ¿Me están dejando pistas o se están burlando de mí?"
