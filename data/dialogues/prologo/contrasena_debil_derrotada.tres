[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_wpok"]

[resource]
script = ExtResource("1_wpok")
script_text = "# Al vencer a la «Contraseña débil» (después de que la Nullblade se va y Kai recoge el fragmento de vida).
Prof. Alvarado [sorprendido]: ¿Qué fue todo ese ruido? ¿Ya quedó?
Kai: Casi, profe. La contraseña vieja ya no protege nada.
Kai [pensativo]: Ahora hay que elegir una nueva... y esta vez, una buena."
