[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_7c6tn"]

[resource]
script = ExtResource("1_7c6tn")
script_text = "# Al llegar a la cuenta del profesor (dentro de la PC). Kai habla con el profesor desde afuera.
Kai: ¡Profe, aquí está el error! Encontré su cuenta.
Prof. Alvarado [preocupado]: ¿Y qué tiene? ¿Está dañada?
Kai [pensativo]: Todavía no sé. Hay una terminal aquí al lado: voy a revisar la configuración de su cuenta."
