script = ExtResource("1_invrec")
script_text = "# H5: si Kai vuelve a hablarle antes de entrar al cuarto viejo.
Prof. Alvarado: El pasillo viejo está al fondo del laboratorio, pasando los servidores. Ten cuidado, ¿sí?"
