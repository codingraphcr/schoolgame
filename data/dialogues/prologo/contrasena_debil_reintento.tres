[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_wpre"]

[resource]
script = ExtResource("1_wpre")
script_text = "# Al volver a intentar el combate después de perder.
Contraseña débil: ¿Otra vez tú? ¡Soy imposible de olvidar!
Kai [serio]: Justamente ese es el problema."
