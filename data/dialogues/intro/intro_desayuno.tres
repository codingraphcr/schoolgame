[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Escena 3: el desayuno en familia.
Mamá: Buenos días, dormilón.
Kai [sonriente]: Buenos días, ma.
Papá: ¿Descansaste bien?
Kai: Buenísimo. Hasta que descubrí que el tiempo existe.
Mamá: Comé algo antes de salir.
Kai [preocupado]: Ma, voy tardísimo.
Mamá: Pues hubieras salido de la cama cuando sonó la alarma."
