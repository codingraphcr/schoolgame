[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(Un sonido grave recorre la estación. Las luces se vuelven rojas.)
Aegis: Alerta. La reparación reactivó los protocolos de emergencia. La estación se está sellando.
Kai: ¡¿Ahora?! ¡Vámonos!
Aegis: Puedo ayudar. Función disponible: Aegis Pulse. Cuando lo indiques, dispararé al objetivo válido más cercano.
Kai: ¿Como un perrito guardián láser?
Aegis: No comprendo la comparación. Pero sí."
