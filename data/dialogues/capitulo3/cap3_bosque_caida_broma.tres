[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "Aegis: Detecté una caída no controlada de aproximadamente veintitrés metros.
Kai: Fue un salto calculado.
Aegis: El cálculo fue incorrecto.
Kai: ...Ya empezamos.
Aegis: La ruta del claro conecta con la red de tu colegio. Está restaurada.
Kai: Entonces, a casa. Bueno, al colegio. Primero el colegio."
