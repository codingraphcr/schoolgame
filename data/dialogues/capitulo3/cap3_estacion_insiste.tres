[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(La compuerta no se mueve.)
Kai: Vamos... ¿Hola? ¿Estás ahí adentro? Ya me ayudaste dos veces.
(Una luz azul recorre los circuitos de la compuerta, muy despacio.)"
