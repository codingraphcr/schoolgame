[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "Guardián: SECTOR DE PROTECCIÓN. LO QUE SE PROTEGE, SE PROTEGE PARA ALGUIEN.
Guardián: ¿SABES QUIÉN PUEDE ENTRAR, Y POR QUÉ?
Kai: Esa la sé desde el primer día de clases."
