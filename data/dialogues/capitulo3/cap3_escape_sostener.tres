[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(El puente de salida se está deshaciendo. Aegis vuela hasta el mecanismo y lo sostiene con su luz.)
Aegis: Yo mantengo el puente. Cruza.
Kai: ¡Aguantá, ya voy!"
