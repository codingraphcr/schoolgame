[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "Señal: POR FAVOR, EVITA VOLVER A CAER.
Kai: ¿Eso fue una indirecta?
Señal: RESULTADO DEL CÁLCULO: INCORRECTO.
Kai: Ah, bueno. Encima de misterioso, gracioso.
(La luz azul titila, más débil que antes, y se aleja hacia el fondo del bosque.)
Kai [pensativo]: Se está apagando... ¿Me estuvo cuidando todo este tiempo?"
