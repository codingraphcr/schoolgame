[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 1, «Camino a casa»: mamá y papá a solas, mientras Kai duerme. Una pista: no se explica nada.
Mamá: ¿Creés que ya empezó?
Papá: No lo sé.
(Silencio. Solo se oye la tele, muy bajito.)
Mamá: No podemos protegerlo de todo.
Papá: Lo sé. Pero podemos enseñarle a elegir."
