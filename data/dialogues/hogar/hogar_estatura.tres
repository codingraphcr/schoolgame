[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(En el marco de la puerta hay rayitas con fechas: la estatura de Kai, año por año.)
Kai: Papá insiste en medirme cada cumpleaños. Este año crecí como tres centímetros."
