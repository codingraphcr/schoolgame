[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Capítulo 1, «Camino a casa»: la primera charla familiar (parte 1, mamá). Afecto y preocupación: no se revela nada.
Mamá: ¡Kai! Ya estaba empezando a preocuparme. ¿Cómo te fue hoy?
Kai: Bien... creo. Pasaron algunas cosas raras en el colegio.
Mamá: ¿Raras cómo?
Kai: No sé cómo explicarlo. Sentí que había cosas que solo yo podía ver.
Mamá: ¿Y eso te asustó?
Kai: Un poco. Pero también sentí que tenía que hacer algo.
(Mamá se queda en silencio un momento. Mira hacia la sala.)"
