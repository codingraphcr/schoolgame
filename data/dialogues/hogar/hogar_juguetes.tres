[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(La caja de juguetes de cuando Kai era chiquito: un carrito, una pelota y un dinosaurio sin cola.)
Kai: Debería regalarlos... pero todavía no me animo."
