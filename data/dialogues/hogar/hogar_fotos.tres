[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(Fotos de la familia: los tres en la playa, Kai con su primer uniforme, papá enseñándole a andar en bici.)
Kai: Mamá guarda fotos de todo. Hasta de cuando me caí de la bici."
