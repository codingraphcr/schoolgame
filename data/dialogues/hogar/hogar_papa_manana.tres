[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "Papá: Buenos días, campeón. ¿Listo para otro día?
Kai: Supongo... Ayer fue mucho.
Papá: Un día a la vez, Kai. Y acordate de lo que hablamos.
Kai: Lo de la responsabilidad. Sí, pa."
