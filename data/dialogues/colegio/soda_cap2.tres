script = ExtResource("1_dlg")
script_text = "Señora de la soda: Dicen que hoy hay actividad de robótica en el taller.
Señora de la soda: Coma algo antes, que con la panza vacía no se piensa.
Kai: Una empanada, entonces. De queso."
