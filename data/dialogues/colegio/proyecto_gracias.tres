[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "Kai: Tu archivo no se borró: estaba en respaldo/viejos. Lo movieron cuando fallaron las compus.
Estudiante: ¿En serio? ...¡Sí! ¡Aquí está todo!
Estudiante: Voy a hacer una copia en mi llave maya ahora mismo. Y otra en la nube del colegio.
Kai: Buena idea: dos copias, en dos lugares distintos.
Estudiante: Te debo una. Si necesitás algo del taller, preguntame."
