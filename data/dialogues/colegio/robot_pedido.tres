[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "# Tarea «El robot que no obedece» (Capítulo 2): el robot de la Compañera hace las cosas en otro orden.
Compañera: Kai, ¿tenés un minuto? Mi robot no obedece.
Compañera: Tiene que llevar una pieza a la caja, pero la suelta antes de moverse... o choca con el borde.
Kai: ¿Y las instrucciones están bien?
Compañera: Son las correctas. Creo. Las puse en la mesa del fondo, ¿le echás un ojo?"
