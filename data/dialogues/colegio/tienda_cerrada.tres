[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
script_text = "(La puerta de al lado de la soda tiene un rótulo: «Tienda de la soda · Pregunte en la soda».)
Kai: Está cerrada. Tal vez la señora de la soda sabe algo."
