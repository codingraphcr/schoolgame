[gd_resource type="Resource" script_class="Keepsake" load_steps=4 format=3]

[ext_resource type="Script" path="res://systems/home/keepsake.gd" id="1_item"]
[ext_resource type="Script" path="res://systems/home/keepsake_note.gd" id="2_note"]

[sub_resource type="Resource" id="Note_0"]
script = ExtResource("2_note")
min_chapter = 0
text = "«Observador: reconocido». ¿Reconocido por quién?"

[resource]
script = ExtResource("1_item")
id = &"fragmento_hermanos"
display_name = "Fragmento de Datos de Chip y Glitch"
category = 1
description = "El fragmento que Chip dejó caer después del combate: «Lo encontramos acá adentro. No sabemos qué es»."
unlock_flag = &"cap1_fragmento_leido"
notes = Array[ExtResource("2_note")]([SubResource("Note_0")])
data_lines = PackedStringArray("ORIGEN: DESCONOCIDO", "ESTADO: INCOMPLETO", "OBSERVADOR: RECONOCIDO", "PROTOCOLO: [DATOS CORRUPTOS]")
art = &"fragmento_rojo"
shelf_slot = 1
