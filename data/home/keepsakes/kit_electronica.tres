[gd_resource type="Resource" script_class="Keepsake" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/home/keepsake.gd" id="1_item"]
[ext_resource type="Script" path="res://systems/home/keepsake_note.gd" id="2_note"]

[sub_resource type="Resource" id="Note_0"]
script = ExtResource("2_note")
min_chapter = 0
text = "Lo primero que armé fue una alarma para que nadie entrara a mi cuarto. Sonaba con cualquier cosa."

[sub_resource type="Resource" id="Note_1"]
script = ExtResource("2_note")
min_chapter = 5
text = "Mamá y papá no sabían nada de electrónica, pero me lo regalaron igual. Siempre supieron qué me gustaba."

[resource]
script = ExtResource("1_item")
id = &"kit_electronica"
display_name = "Kit de electrónica"
category = 2
description = "El regalo de sus doce años: una placa, cables, un chip y un LED rojo que todavía prende."
unlock_flag = &""
notes = Array[ExtResource("2_note")]([SubResource("Note_0"), SubResource("Note_1")])
art = &"kit_electronica"
shelf_slot = 4
