[gd_resource type="Resource" script_class="Keepsake" load_steps=6 format=3]

[ext_resource type="Script" path="res://systems/home/keepsake.gd" id="1_item"]
[ext_resource type="Script" path="res://systems/home/keepsake_note.gd" id="2_note"]

[sub_resource type="Resource" id="Note_0"]
script = ExtResource("2_note")
min_chapter = 0
text = "Mamá dice que es su foto favorita. Papá dice que no, porque salió con los ojos cerrados."

[sub_resource type="Resource" id="Note_1"]
script = ExtResource("2_note")
min_chapter = 5
text = "Me gusta esta foto. Ahí no había preguntas: solo estábamos los tres."

[sub_resource type="Resource" id="Note_2"]
script = ExtResource("2_note")
min_chapter = 9
text = "Quizá no importa tanto de dónde venimos como lo que decidimos hacer con nuestra vida."

[resource]
script = ExtResource("1_item")
id = &"foto_familia"
display_name = "Fotografía familiar"
category = 0
description = "Los tres en la playa, el verano en que Kai aprendió a nadar. Papá salió con los ojos cerrados."
unlock_flag = &""
notes = Array[ExtResource("2_note")]([SubResource("Note_0"), SubResource("Note_1"), SubResource("Note_2")])
art = &"foto_familia"
shelf_slot = 1
