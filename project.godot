; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nullveil: Beyond the Firewall"
config/description="Videojuego educativo de ciberseguridad."
config/version="0.1.0"
run/main_scene="res://ui/menus/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.067, 0.141, 1)
config/icon="res://icon.svg"

[autoload]

SceneManager="*res://autoload/scene_manager.gd"
GameState="*res://autoload/game_state.gd"
DigitalVision="*res://autoload/digital_vision.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://ui/theme/main_theme.tres"

